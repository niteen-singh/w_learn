<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('./partials/head') %>
        <title>HomePage</title>
    </head>
    <body>
        <%- include('./partials/nav') %>
        <div class="container mt-3">
            <form actions="/blog" method="post" enctype="multipart/form-data">
                <div class="mt-3">
                    <label for="coverimage">Cover Image</label>
                    <input
                        class="form-control"
                        id="coverimage"
                        name="coverimage"
                        type="file"
                        aria-describedby="title"
                    />
                </div>
                <div class="mb-3">
                    <label for="title">Title</label>
                    <input
                        class="form-control"
                        id="title"
                        name="title"
                        type="text"
                        aria-describedby="title"
                    />
                </div>
                <div class="mt-3">
                    <label for="body">Body</label>
                    <textarea
                        name="body"
                        class="form-control mt-3"
                        placeholder="Write your Blog"
                        id="body"
                        style="height: 100px"
                    ></textarea>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary">submit</button>
                </div>
            </form>
        </div>
        <%- include('./partials/script') %>
    </body>
</html>
