<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('./partials/head') %>
        <title>blog</title>
    </head>
    <body>
        <%- include('./partials/nav') %>
        <div class="container mt-4">
            <h1 class="card-title"><%= blog.title %></h1>
            <img src="<%= blog.coverimgurl %>" width="700px" />
            <pre><%= blog.body %></pre>
        </div>
        <div class="container mt-4">
            <img
                src="<%= blog.profile_photo || '/default/avatar.svg' %> "
                width="35px"
            />
            <%= blog.full_name %>
        </div>

        <% if (locals.user) { %>
            <div class="container mt-4">
            <form action="/comment/<%= blog.id %>" method="post">
                <div class="mt-3">
                    <input
                        class="form-control"
                        id="content"
                        name="content"
                        type="text"
                    />
                </div>
                    <button type="submit" class="btn btn-primary">add</button>
                </div>
            </form>
        </div>
        <% } %>

        <div class="mt-3">
            <% comments.forEach(comment => { %>
                <div class="container mt-4">
                    <img
                        src="<%= '/default/avatar.svg' %> "
                        width="35px"
                        />
                    <%= comment.createdby %>
                    <pre><%= comment.content %></pre>
                </div>
            <% }) %>
        </div>

        <%-include('./partials/script') %>
    </body>
</html>
