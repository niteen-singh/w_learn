<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics</title>
</head>
<body>
    <ol>
        <% users.forEach(user => { %>
            <li>short code: <%= user.short_code %> | analytics: <%= user.analytics %> | orignal url: <%= user.orignal_url %></li>
        <% }) %>
    </ol>
</body>
</html>